<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <!-- Section label -->
    <TextView
        android:id="@+id/visTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LIVE TOWER"
        android:fontFamily="@font/orbitron"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/visSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tower_default_subtitle"
        android:fontFamily="@font/rajdhani"
        android:textStyle="bold"
        android:textSize="28sp"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/visTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/visSourceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/tower_source_cached"
        android:textSize="14sp"
        android:fontFamily="@font/rajdhani"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/visSubtitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Slot grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/slotRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/visSourceText"
        app:layout_constraintBottom_toTopOf="@id/activePlatformCard"
        app:layout_constraintVertical_bias="0" />

    <!-- Active position card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/activePlatformCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_directions"
                android:padding="12dp"
                android:backgroundTint="?attr/colorSurface"
                app:tint="?attr/colorOnSurface"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                android:contentDescription="Position icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tower_current_platform"
                    android:fontFamily="@font/rajdhani"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:alpha="0.8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/activePlatformLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tower_active_idle"
                    android:fontFamily="@font/orbitron"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="18sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/rotationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tower_status_cached"
                android:fontFamily="@font/orbitron"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSecondaryContainer" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>