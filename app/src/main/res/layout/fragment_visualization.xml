<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground"
    android:padding="20dp">

    <!-- Section label -->
    <TextView
        android:id="@+id/visTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tower Analysis"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:letterSpacing="0.08"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/visSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Interactive structure view"
        android:fontFamily="sans-serif-medium"
        android:textSize="22sp"
        android:textColor="?attr/colorOnBackground"
        app:layout_constraintTop_toBottomOf="@id/visTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Slot grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/slotRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/visSubtitle"
        app:layout_constraintBottom_toTopOf="@id/activePlatformCard"
        app:layout_constraintVertical_bias="0" />

    <!-- Active position card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/activePlatformCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="18dp"
            android:gravity="center_vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_directions"
                android:padding="8dp"
                android:backgroundTint="?attr/colorSecondary"
                app:tint="?attr/colorOnSecondary"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent"
                android:contentDescription="Position icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active position"
                    android:fontFamily="sans-serif"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:alpha="0.70"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/activePlatformLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slot 08  Base"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/rotationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Static"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSecondaryContainer" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>