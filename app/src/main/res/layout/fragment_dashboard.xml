<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".DashboardFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/dashboardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="48dp">

            <!-- Title & System Status Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="32dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONTROL CENTER"
                        android:fontFamily="@font/orbitron"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <View
                            android:id="@+id/pulseStatusDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/status_indicator"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tvRealtimeMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIVE MANAGER ONLINE"
                            android:fontFamily="@font/rajdhani"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            android:letterSpacing="0.05" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Hero Status Card (Bold Primary Theme) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorPrimary">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="32dp">

                    <TextView
                        android:id="@+id/lblAvailable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVAILABLE PARKING"
                        android:fontFamily="@font/rajdhani"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimary"
                        android:alpha="0.8"
                        android:textSize="14sp"
                        android:letterSpacing="0.1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tv_available_slots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="64sp"
                        android:fontFamily="@font/orbitron"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        app:layout_constraintTop_toBottomOf="@id/lblAvailable"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvTotalSlots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/ 20 SLOTS"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="16sp"
                        android:fontFamily="@font/rajdhani"
                        android:alpha="0.8"
                        app:layout_constraintBaseline_toBaselineOf="@id/tv_available_slots"
                        app:layout_constraintStart_toEndOf="@id/tv_available_slots"
                        android:layout_marginStart="8dp" />

                    <!-- Utilization Text replacing complex progress circle to keep it cleaner -->
                    <TextView
                        android:id="@+id/systemStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30% FULL"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="16sp"
                        android:fontFamily="@font/orbitron"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Row -->
            <LinearLayout
                android:id="@+id/rowQuickActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Park Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnParkLarge"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_park_vehicle"
                            app:tint="?attr/colorOnPrimaryContainer"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PARK"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:fontFamily="@font/orbitron"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Retrieve Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnRetrieveLarge"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_retrieve_vehicle"
                            app:tint="?attr/colorOnSecondaryContainer"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RETRIEVE"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:fontFamily="@font/orbitron"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Minimal System Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOperational"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_system_check"
                        app:tint="?attr/colorPrimary"
                        android:layout_marginEnd="16dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All Systems Optimal"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:fontFamily="@font/rajdhani"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>